<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rapidcode_draw_plane</name>
  <version>0.1.0</version>
  <description>
    Bridge for the rapidcode_draw_plane product: receives operator drawing input from
    the Windows drawing surface client and drives the passthrough trajectory
    controller, in Batch (recipe goals) and Live (pose stream) modes.
  </description>
  <maintainer email="tech@roboticsys.com">RSI</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>control_msgs</depend>
  <depend>std_srvs</depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-websockets</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
